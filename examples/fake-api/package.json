{
  "name": "fics-fake-api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:js": "bun build src/{,**/}*.ts --outdir dist --splitting --minify",
    "build:css": "bunx postcss src/{,**/}*.css --dir dist --minify",
    "build:packages": "cd ../../packages && bun run build && cd ../examples/fake-api",
    "dev": "rm -rf dist && bun run build:packages && bun run build:js && bun run build:css && bun run --hot app.ts"
  },
  "dependencies": {
    "ficsjs": "*",
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "3.4.17"
  }
}